    srcs = ["head_weights.zig"],
    import_name = "zml_lib/trellis/heads",
    visibility = ["//visibility:public"],
    deps = [":flow", "//runtime:runtime", "@zml//zml/core"],
)

zig_binary(
    name = "trellis_heads",
    main = "head_probe.zig",
    deps = [":heads", "//runtime:runtime", "@zml//zml/core"],
)
