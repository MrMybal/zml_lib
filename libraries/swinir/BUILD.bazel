load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library")

zig_library(
    name = "model",
    main = "model.zig",
    srcs = ["weights.zig"],
    import_name = "zml_lib/swinir",
    visibility = ["//visibility:public"],
    deps = ["//runtime:runtime", "@zml//zml/core"],
)

zig_binary(
    name = "swinir_probe",
    main = "probe.zig",
    deps = [":model", "//runtime:runtime"],
)

zig_binary(
    name = "swinir_color_dn_probe",
    main = "color_dn_probe.zig",
    deps = [":model", "//runtime:runtime"],
)
